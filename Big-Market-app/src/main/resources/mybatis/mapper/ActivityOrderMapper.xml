<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="shirlin.ai.infrastructure.dao.IActivityOrderDao">

    <resultMap id="BaseResultMap" type="shirlin.ai.infrastructure.dao.po.ActivityOrder">
        <id column="id" property="id" />
        <result column="order_id" property="orderId" />
        <result column="user_id" property="userId" />
        <result column="activity_id" property="activityId" />
        <result column="sku_id" property="skuId" />
        <result column="strategy_id" property="strategyId" />
        <result column="order_status" property="orderStatus" />
        <result column="points_cost" property="pointsCost" />
        <result column="out_business_no" property="outBusinessNo" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, order_id, user_id, activity_id, sku_id, strategy_id, order_status,
        points_cost, out_business_no, create_time, update_time
    </sql>

    <insert id="insert" parameterType="shirlin.ai.infrastructure.dao.po.ActivityOrder" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_order (order_id, user_id, activity_id, sku_id, strategy_id, order_status,
                                    points_cost, out_business_no, create_time, update_time)
        VALUES (#{orderId}, #{userId}, #{activityId}, #{skuId}, #{strategyId}, #{orderStatus},
                #{pointsCost}, #{outBusinessNo}, NOW(), NOW())
    </insert>

    <update id="updateById" parameterType="shirlin.ai.infrastructure.dao.po.ActivityOrder">
        UPDATE activity_order
        SET order_id = #{orderId},
            user_id = #{userId},
            activity_id = #{activityId},
            sku_id = #{skuId},
            strategy_id = #{strategyId},
            order_status = #{orderStatus},
            points_cost = #{pointsCost},
            out_business_no = #{outBusinessNo},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM activity_order WHERE id = #{id}
    </delete>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity_order WHERE id = #{id}
    </select>

    <select id="selectByOrderId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity_order WHERE order_id = #{orderId}
    </select>

    <select id="selectByOutBusinessNo" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity_order WHERE out_business_no = #{outBusinessNo}
    </select>

    <select id="selectByUserIdAndActivityId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity_order
        WHERE user_id = #{userId} AND activity_id = #{activityId}
        ORDER BY create_time DESC
    </select>

    <update id="updateOrderStatus">
        UPDATE activity_order
        SET order_status = #{orderStatus},
            update_time = NOW()
        WHERE order_id = #{orderId}
    </update>

</mapper>

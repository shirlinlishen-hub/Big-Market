<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="shirlin.ai.infrastructure.dao.IActivityDao">

    <resultMap id="BaseResultMap" type="shirlin.ai.infrastructure.dao.po.Activity">
        <id column="id" property="id" />
        <result column="activity_id" property="activityId" />
        <result column="activity_name" property="activityName" />
        <result column="activity_desc" property="activityDesc" />
        <result column="strategy_id" property="strategyId" />
        <result column="status" property="status" />
        <result column="begin_time" property="beginTime" />
        <result column="end_time" property="endTime" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, activity_id, activity_name, activity_desc, strategy_id, status,
        begin_time, end_time, create_time, update_time
    </sql>

    <insert id="insert" parameterType="shirlin.ai.infrastructure.dao.po.Activity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity (activity_id, activity_name, activity_desc, strategy_id, status,
                              begin_time, end_time, create_time, update_time)
        VALUES (#{activityId}, #{activityName}, #{activityDesc}, #{strategyId}, #{status},
                #{beginTime}, #{endTime}, NOW(), NOW())
    </insert>

    <update id="updateById" parameterType="shirlin.ai.infrastructure.dao.po.Activity">
        UPDATE activity
        SET activity_name = #{activityName},
            activity_desc = #{activityDesc},
            strategy_id = #{strategyId},
            status = #{status},
            begin_time = #{beginTime},
            end_time = #{endTime},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM activity WHERE id = #{id}
    </delete>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity WHERE id = #{id}
    </select>

    <select id="selectByActivityId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity WHERE activity_id = #{activityId}
    </select>

    <select id="selectByStrategyId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity WHERE strategy_id = #{strategyId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity
    </select>

    <select id="selectByStatus" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM activity WHERE status = #{status}
    </select>

</mapper>

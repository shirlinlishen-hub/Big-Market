<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="shirlin.ai.infrastructure.dao.IAwardDao">

    <resultMap id="BaseResultMap" type="shirlin.ai.infrastructure.dao.po.Award">
        <id column="id" property="id" />
        <result column="award_id" property="awardId" />
        <result column="award_key" property="awardKey" />
        <result column="award_config" property="awardConfig" />
        <result column="award_desc" property="awardDesc" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, award_id, award_key, award_config, award_desc, create_time, update_time
    </sql>

    <insert id="insert" parameterType="shirlin.ai.infrastructure.dao.po.Award" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO award (award_id, award_key, award_config, award_desc, create_time, update_time)
        VALUES (#{awardId}, #{awardKey}, #{awardConfig}, #{awardDesc}, NOW(), NOW())
    </insert>

    <update id="updateById" parameterType="shirlin.ai.infrastructure.dao.po.Award">
        UPDATE award
        SET award_key = #{awardKey},
            award_config = #{awardConfig},
            award_desc = #{awardDesc},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM award WHERE id = #{id}
    </delete>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM award WHERE id = #{id}
    </select>

    <select id="selectByAwardId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM award WHERE award_id = #{awardId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM award
    </select>

    <select id="selectByAwardIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" /> FROM award WHERE award_id IN
        <foreach collection="awardIds" item="awardId" open="(" separator="," close=")">
            #{awardId}
        </foreach>
    </select>

</mapper>